<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7E9CFE6"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="@drawable/lock_card_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="六点见  ☀"
            android:textColor="#5A4632"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="距离今天 18:00 开播还有"
            android:textColor="#7B6042"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="00:00:00"
            android:textColor="#49321E"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="苏打水 · 今天也准时见"
            android:textColor="#9A7752"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lockClose"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:gravity="center"
        android:background="@drawable/encouragement_close_bg"
        android:text="×"
        android:textColor="#6A5139"
        android:textSize="25sp" />

</FrameLayout>
