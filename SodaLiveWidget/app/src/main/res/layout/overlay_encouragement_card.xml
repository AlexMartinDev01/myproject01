<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="400dp"
    android:background="@drawable/encouragement_shell">

    <ImageView
        android:id="@+id/encouragementImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="开播前鼓励卡" />

    <TextView
        android:id="@+id/encouragementClose"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:gravity="center"
        android:background="@drawable/encouragement_close_bg"
        android:text="×"
        android:textColor="#6A5139"
        android:textSize="24sp"
        android:textStyle="bold" />

</FrameLayout>
